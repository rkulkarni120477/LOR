# Copy to .env and fill in. NEVER commit real values. .env is git-ignored.
# No secrets are stored here: AWS credentials come from the standard AWS chain.

# --- Runtime -----------------------------------------------------------------
# development | staging | production. Dev token issuer and file:// JWKS work only in development.
ENV=development
LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------
# SQLite for local use. For production, e.g. postgresql+psycopg://user:pass@host/lor
DATABASE_URL=sqlite:///./lor.db

# Comma-separated JSON list. Must include the frontend origin.
CORS_ORIGINS=["http://localhost:3000"]

# --- OIDC / JWT ----------------------------------------------------------------
# Issuer URL exactly as it appears in the "iss" claim of your IdP tokens.
OIDC_ISSUER=http://dev-issuer.local
# JWKS endpoint of the IdP, e.g. https://login.example.com/.well-known/jwks.json
# For local dev only: file://.dev_keys/jwks.json (created by scripts/dev_token_issuer.py)
OIDC_JWKS_URL=file://.dev_keys/jwks.json
# Expected "aud" claim.
OIDC_AUDIENCE=lor-api
# Claim holding the role list, e.g. roles or groups mapped to Learner/Contributor/Reviewer/Admin.
OIDC_ROLES_CLAIM=roles
OIDC_ALGORITHMS=["RS256"]
OIDC_JWKS_CACHE_SECONDS=300

# Microsoft Entra ID (Azure AD) sign-in for the academian tenant. SSO stays off until all of these are set.
# Register an app in Entra admin center > App registrations; redirect URI (Web):
#   http://localhost:3000/api/v1/auth/callback  (add the production URL too)
# Issuer for a single tenant (replace <tenant-id> with the Directory (tenant) ID GUID):
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=<application-client-id>
OIDC_TOKEN_AUTH_METHOD=client_secret_post
OIDC_CLIENT_SECRET=<client-secret-value, keep out of git>
OIDC_ALLOWED_TENANT_ID=<tenant-id>
OIDC_ALLOWED_EMAIL_DOMAINS=["academian.com"]
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
APP_ORIGIN=http://localhost:3000

# --- AWS / Bedrock -------------------------------------------------------------
# Credentials: use AWS_PROFILE, AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY (local only), or an IAM role.
AWS_REGION=us-east-1
# Claude model ID enabled in your Bedrock account (verify in the Bedrock console).
BEDROCK_CHAT_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Titan text embedding model ID.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Must match the embedding model's output size (Titan v2 default is 1024).
EMBEDDING_DIMENSIONS=1024
# Optional Bedrock Guardrails. Off by default.
GUARDRAILS_ENABLED=false
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# --- Storage -------------------------------------------------------------------
# local | s3 (private bucket; credentials use the standard AWS credential chain)
STORAGE_BACKEND=local
S3_BUCKET=
REDIS_URL=redis://localhost:56379/0
CELERY_RESULT_BACKEND=redis://localhost:56379/1
SEARCH_BACKEND=sql
OPENSEARCH_URL=http://localhost:59200
OPENSEARCH_INDEX=elor-content-v1
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=true
LOCAL_STORAGE_PATH=./data/storage
MAX_UPLOAD_BYTES=209715200

# --- Agent and vector stores (SQLite files) -------------------------------------
CHECKPOINT_DB_PATH=./checkpoints.db
VECTOR_DB_PATH=./vectors.db

# --- Confidence thresholds (0.0 to 1.0) -----------------------------------------
# Compliance scores below this pause the ingest graph for human review.
COMPLIANCE_THRESHOLD=0.7
METADATA_CONFIDENCE_THRESHOLD=0.6
TAXONOMY_CONFIDENCE_THRESHOLD=0.5

# --- Frontend (frontend/.env.local, not this file) ------------------------------
# BACKEND_URL=http://localhost:8000

# --- Upload processing ---------------------------------------------------------
# signature (built in: EICAR, executables, nested archives) | clamav (clamd over TCP, in addition).
# Scanner errors quarantine the upload. clamav requires CLAMAV_HOST.
MALWARE_SCANNER=signature
CLAMAV_HOST=
CLAMAV_PORT=3310
# Multipart part size in bytes (default 8 MiB). S3 requires at least 5 MiB per part.
UPLOAD_PART_BYTES=8388608
UPLOAD_SESSION_SECONDS=86400
# Accept zip packages with no SCORM, cmi5 or xAPI manifest (stored with a warning).
ALLOW_GENERIC_ZIP=true
